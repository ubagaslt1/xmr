FROM ubuntu:22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV APP_DATA=/data
ENV TZ=UTC

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    ca-certificates \
    tor \
    nginx \
    supervisor \
    sqlite3 \
    python3 \
    python3-pip \
    python3-venv \
    net-tools \
    curl \
    jq \
    iptables \
    cron \
    libboost-all-dev \
    libssl-dev \
    libzmq3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Monero
RUN wget https://downloads.getmonero.org/cli/linux64 -O /tmp/monero.tar.bz2 \
    && tar -xjf /tmp/monero.tar.bz2 -C /tmp \
    && cp /tmp/monero-*/monerod /usr/local/bin/ \
    && cp /tmp/monero-*/monero-wallet-rpc /usr/local/bin/ \
    && rm -rf /tmp/monero*

# Copy application files
COPY . .

# Create directories
RUN mkdir -p /data /blockchain /var/www/html \
    && chown -R www-data:www-data /app /var/www/html

# Install Python dependencies
RUN pip3 install --no-cache-dir -r requirements.txt \
    && pip3 install --no-cache-dir -r web/requirements.txt

# Set permissions
RUN chmod +x entrypoint.sh *.py \
    && chmod +x firewall.sh

# Configure services
RUN cp nginx.conf /etc/nginx/nginx.conf \
    && cp supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Create non-root user
RUN useradd -m -u 1000 umbrel \
    && chown -R umbrel:umbrel /app /data

USER umbrel

EXPOSE 8080 18080 18089

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
