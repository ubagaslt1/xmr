FROM ubuntu:22.04

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    tor \
    nginx \
    supervisor \
    sqlite3 \
    python3 \
    python3-pip \
    python3-venv \
    net-tools \
    curl \
    jq \
    dnsutils \
    iptables \
    fail2ban \
    && rm -rf /var/lib/apt/lists/*

# Install Monero
RUN wget https://downloads.getmonero.org/cli/linux64 -O /tmp/monero.tar.bz2 && \
    tar -xjf /tmp/monero.tar.bz2 -C /tmp && \
    cp /tmp/monero-*/monerod /usr/local/bin/ && \
    cp /tmp/monero-*/monero-wallet-rpc /usr/local/bin/ && \
    rm -rf /tmp/monero*

# Install Python dependencies
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

# Copy application files
COPY . .

# Create directories
RUN mkdir -p /data/seeds /data/trusted /data/untrusted /data/logs /data/db \
    /data/blockchain /data/tor/trusted /data/tor/untrusted \
    /var/www/html /blockchain && \
    chown -R www-data:www-data /app /data /var/www/html

# Configure services
COPY nginx.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY torrc-trusted /etc/tor/torrc-trusted
COPY torrc-untrusted /etc/tor/torrc-untrusted

# Copy scripts
COPY entrypoint.sh /entrypoint.sh
COPY generate_trusted_seeds.py /generate_trusted_seeds.py
COPY create_network.py /create_network.py
COPY enforce_trust.py /enforce_trust.py
COPY block_untrusted.py /block_untrusted.py
COPY monitor_network.py /monitor_network.py
COPY web/app.py /app/web/app.py
RUN chmod +x /entrypoint.sh /*.py

# Setup firewall rules
COPY firewall.sh /firewall.sh
RUN chmod +x /firewall.sh

EXPOSE 8080 18080 18081 18089

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8080/api/health || exit 1

ENTRYPOINT ["/entrypoint.sh"]
